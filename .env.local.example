# ─────────────────────────────────────────────────────────────
# My ref archive — 환경변수 예시 파일
#
# 이 파일은 "어떤 값이 필요한지"만 보여주는 예시입니다. 실제 값은 없습니다.
# 로컬에서 테스트하려면 이 파일을 복사해 `.env.local` 로 이름을 바꾸고
# 오른쪽에 실제 값을 채워 넣으세요. (`.env.local` 은 절대 GitHub에 올라가지 않습니다.)
# 실제 배포에서는 Vercel 대시보드의 Settings → Environment Variables 에 등록합니다.
# ─────────────────────────────────────────────────────────────

# [1] Google Gemini API 키 — https://aistudio.google.com/apikey 에서 발급 (무료, 카드 등록 불필요)
#     이 키는 서버에서만 사용되고 브라우저에는 절대 노출되지 않습니다.
GEMINI_API_KEY=

# [2][3] Upstash Redis 접속 정보 — Vercel Marketplace에서 Upstash를 연동하면
#        아래 두 값이 Vercel에 자동으로 주입됩니다. 로컬 테스트 때만 직접 채우세요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [4] 로그인 세션에 서명하는 데 쓰는 비밀 값 — 아무도 모르는 긴 임의의 문자열이면 됩니다.
#     터미널에서 `openssl rand -base64 32` 실행하면 만들어져요. 절대 공개하지 마세요.
SESSION_SECRET=
